{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "app/**/*.tsx",
    "lib/**/*.ts",
    "demo/**/*.tsx",
    "tests/**/*.ts",
    "vite.config.ts"
  ]
}
